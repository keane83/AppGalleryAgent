OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=glm-4.7-flash:q4_K_M
# 工具内 LLM（商店文案等）可单独指定更小模型以加速，如 qwen2.5:7b
# OLLAMA_TOOL_MODEL=qwen2.5:7b
OLLAMA_REASONING=false
OLLAMA_KEEP_ALIVE=30m
# OLLAMA_TEMPERATURE=0.2
# AppGallery 商店文案分析：fast(默认,关键词分类+小prompt) | llm(慢,全量) | heuristic(最快,无LLM)
# APP_GALLERY_LISTING_ANALYSIS_MODE=fast
LOG_LEVEL=INFO

# AppGallery Connect API（团队级 API 客户端）
APP_GALLERY_API_CLIENT_ID=
APP_GALLERY_API_CLIENT_SECRET=
APP_GALLERY_API_PROJECT_ID=
APP_GALLERY_API_CERT_ID=
# APP_GALLERY_API_TOKEN_URL=https://connect-api.cloud.huawei.com/api/oauth2/v1/token
# APP_GALLERY_API_BASE_URL=https://connect-api.cloud.huawei.com/api
# APP_GALLERY_DEFAULT_CONTACT_NAME=刘健
# APP_GALLERY_DEFAULT_CONTACT_PHONE=15509840527
# APP_GALLERY_DEFAULT_CONTACT_EMAIL=liujian830527@126.com
# APP_GALLERY_DEFAULT_COLLECT_PERSON_INFO=0
# APP_GALLERY_DEFAULT_AICG_TYPE=0
# APP_GALLERY_DEFAULT_APP_TYPE=2  # registeredDclType: 0=国内服务器 1=海外 2=单机
# PROVISION_DOWNLOAD_DIR=downloads/provisions
# Playwright 控制台自动化（新建发布）
# AGC_MYAPP_URL=https://developer.huawei.com/consumer/cn/service/josp/agc/index.html#/myApp
# AGC_STORAGE_STATE_PATH=downloads/agc_storage_state.json
# BROWSER_ARTIFACT_DIR=downloads/browser
# AGC_BROWSER_HEADLESS=false
# AGC_BROWSER_SLOW_MO_MS=0
# 登录态过期时可改用持久化 Profile（更稳，免频繁 agc_browser_login）
# AGC_BROWSER_USE_PERSISTENT_PROFILE=true
# AGC_BROWSER_USER_DATA_DIR=downloads/agc_chrome_profile

# HarmonyOS 工程签名（AppAutoBAT 固定材料）
# HARMONY_SIGNING_MATERIAL_DIR=AppAutoBAT
# HARMONY_SIGNING_STORE_FILE=appbat123A.p12
# HARMONY_SIGNING_CERT_FILE=appbat123A.cer
HARMONY_SIGNING_STORE_PASSWORD=
HARMONY_SIGNING_KEY_ALIAS=appbat123A
HARMONY_SIGNING_KEY_PASSWORD=
# HARMONY_SIGNING_SIGN_ALG=SHA256withECDSA

# HarmonyOS 模拟器截图（hdc / Emulator）
# DEVECO_STUDIO_PATH=/Applications/DevEco-Studio.app/Contents
# HARMONY_HDC_PATH=
# HARMONY_HVIGORW_PATH=
# HARMONY_EMULATOR_PATH=
# HARMONY_EMULATOR_NAME=Mate 70 Pro   # 必须与 `Emulator -list` 中的名称一致
# HARMONY_EMULATOR_BOOT_TIMEOUT_SEC=180  # 自动启动模拟器后等待 hdc 的最长时间（秒）
# HARMONY_SCREENSHOT_DIR=downloads/screenshots  # 实际路径：{DIR}/{应用名}/{时间戳}/
# FLUTTER_BIN=/path/to/flutter  # Flutter OHOS 工程 build hap 时使用
# HARMONY_LLM_PLANNER=false  # Flutter 截图：默认启发式，失败时可开 LLM
# HARMONY_WEBVIEW_LLM_AUTO=true  # WebView HTML：启发式不足时自动把 HTML 送 LLM 规划切页脚本（默认开）
# HARMONY_WEBVIEW_RENDER_WAIT_SEC=1.5
# HARMONY_WEBVIEW_FIRST_EXTRA_WAIT_SEC=2.5
# OLLAMA_TOOL_MODEL=qwen2.5:7b  # WebView LLM 兜底时可指定更快的小模型

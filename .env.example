
# LLM 后端：ollama（本地）| deepseek（DeepSeek API，OpenAI 兼容）
LLM_PROVIDER=deepseek

OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=glm-4.7-flash:q4_K_M
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_REASONING=true
OLLAMA_KEEP_ALIVE=30m
LOG_LEVEL=INFO

# --- DeepSeek API（LLM_PROVIDER=deepseek）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_MODEL=deepseek-flash
# LLM_API_MODEL=deepseek-v4-pro
# deepseek-v4-pro
# deepseek-flash
# LLM_TOOL_API_MODEL=deepseek-chat

HARMONY_HDC_EMULATOR_ADDR=127.0.0.1:5555

# 项目设置中 Server SDK 中 凭证管理 获取下面信息
# 注意项目要N/A 的 然后列表中注意过滤项目
APP_GALLERY_API_CLIENT_ID=203856044313xxxxxxxxxxxxxx
APP_GALLERY_API_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 项目ID
APP_GALLERY_API_PROJECT_ID=xxxxxxxx

# https://connect-api.cloud.huawei.com/api/publish/v3/cert/list
# https://developer.huawei.com/consumer/cn/doc/doccenter-submission/agc-help-provision-api-query-cent-0000002271160629
# 通过接口才能拿到证书id
APP_GALLERY_API_CERT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



APP_GALLERY_API_TOKEN_URL=https://connect-api.cloud.huawei.com/api/oauth2/v1/token
APP_GALLERY_API_BASE_URL=https://connect-api.cloud.huawei.com/api
PROVISION_DOWNLOAD_DIR=downloads/provisions


# Playwright 控制台自动化（新建发布）
AGC_MYAPP_URL=https://developer.huawei.com/consumer/cn/service/josp/agc/index.html#/myApp
AGC_STORAGE_STATE_PATH=downloads/agc_storage_state.json
BROWSER_ARTIFACT_DIR=downloads/browser
AGC_BROWSER_HEADLESS=false
AGC_BROWSER_SLOW_MO_MS=0

# HarmonyOS 工程签名（AppAutoBAT 固定材料；请填入你的固定密码）
HARMONY_SIGNING_STORE_PASSWORD=xxxxxxxx
HARMONY_SIGNING_KEY_ALIAS=xxxxxxxx
HARMONY_SIGNING_KEY_PASSWORD=xxxxxxxx
HARMONY_SIGNING_MATERIAL_DIR=AppAutoBAT
HARMONY_SIGNING_STORE_FILE=xxxxxxxx.p12
HARMONY_SIGNING_CERT_FILE=xxxxxx.cer
HARMONY_SIGNING_SIGN_ALG=SHA256withECDSA



# HarmonyOS 模拟器截图（hdc / Emulator）
DEVECO_STUDIO_PATH=/Applications/DevEco-Studio.app/Contents
HARMONY_EMULATOR_NAME=Mate 70 Pro
HARMONY_SCREENSHOT_DIR=downloads/screenshots
# HARMONY_HDC_PATH=
# HARMONY_HVIGORW_PATH=
# HARMONY_EMULATOR_PATH=


APP_GALLERY_DEFAULT_CONTACT_NAME=张三
APP_GALLERY_DEFAULT_CONTACT_PHONE=155XXXXXXXX
APP_GALLERY_DEFAULT_CONTACT_EMAIL=123123123@126.com
APP_GALLERY_DEFAULT_COLLECT_PERSON_INFO=0
APP_GALLERY_DEFAULT_AICG_TYPE=0
APP_GALLERY_DEFAULT_APP_TYPE=1

# 默认已是 fast，可不写
APP_GALLERY_LISTING_ANALYSIS_MODE=fast

# AGC_MYAPP_URL=https://developer.huawei.com/consumer/cn/service/josp/agc/index.html#/myApp
# AGC_STORAGE_STATE_PATH=downloads/agc_storage_state.json
# BROWSER_ARTIFACT_DIR=downloads/browser
# AGC_BROWSER_HEADLESS=false
# AGC_BROWSER_SLOW_MO_MS=0

# HarmonyOS 工程签名（AppAutoBAT 固定材料）
# HARMONY_SIGNING_MATERIAL_DIR=AppAutoBAT
# HARMONY_SIGNING_STORE_FILE=appbat123A.p12
# HARMONY_SIGNING_CERT_FILE=appbat123A.cer
HARMONY_SIGNING_STORE_PASSWORD=
HARMONY_SIGNING_KEY_ALIAS=appbat123A
HARMONY_SIGNING_KEY_PASSWORD=
# HARMONY_SIGNING_SIGN_ALG=SHA256withECDSA

# HarmonyOS 模拟器截图（hdc / Emulator）
# DEVECO_STUDIO_PATH=/Applications/DevEco-Studio.app/Contents
# HARMONY_HDC_PATH=
# HARMONY_HVIGORW_PATH=
# HARMONY_EMULATOR_PATH=
# HARMONY_EMULATOR_NAME=Mate 70 Pro
